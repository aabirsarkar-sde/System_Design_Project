# Copy to `.env` on the API host (or use with Docker Compose). No secrets in git.

NODE_ENV=production
PORT=4000

# Public origin of the Next.js app (no trailing slash). Must match the URL users type in the browser.
# CORS for the API — keep in sync with frontends `SITE_BASE_URL` origin.
FRONTEND_ORIGIN=https://your-frontend.example.com

# PostgreSQL (e.g. Neon, RDS, or Docker)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require

# --- Also used by root `docker-compose.yml` for the `web` service build/runtime ---
SITE_BASE_URL=https://your-frontend.example.com
SESSION_SECRET=generate-with-openssl-rand-base64-32
