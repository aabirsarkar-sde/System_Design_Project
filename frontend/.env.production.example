# Required when NODE_ENV=production` (Vercel, Docker, etc.)

# Public URL of this Next app (metadata, sitemap, cookies context)
SITE_BASE_URL=https://your-frontend.example.com

# Base URL of the Express API (server-side only; not exposed to the browser)
BACKEND_API_BASE_URL=https://your-api.example.com

# Long random string — signs the `campus_session` cookie. Do not reuse across environments.
SESSION_SECRET=replace-with-a-long-cryptographically-random-secret
